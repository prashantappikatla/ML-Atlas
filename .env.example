# =============================================================================
# ML Atlas - Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Database (for Alembic migrations) ---
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# --- Backend ---
LAB_BASE_URL=http://localhost:8501
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (NEXT_PUBLIC_ prefix = safe to expose to browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
